{
  "name": "ooa",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic Web Components inspired by Ant Design 6.",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @ooa/components dev",
    "docs": "pnpm --filter docs dev",
    "storybook": "pnpm --filter @ooa/storybook dev",
    "parity": "pnpm --filter @ooa/parity dev",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~6.0.2"
  }
}
