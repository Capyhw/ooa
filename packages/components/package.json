  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.6",
    "lit": "^3.3.0",
    "playwright": "^1.57.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.6",
    "vitest-browser-lit": "^1.0.1"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@ooa/tokens": "workspace:*"
